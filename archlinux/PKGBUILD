pkgname=dumbar
pkgver=v0.0.1.r0.gadb0152
pkgrel=1
pkgdesc='A simple Wayland panel and taskbar built with Qt 6'
arch=('x86_64')
url='https://github.com/tokyo4j/dumbar'
license=('MIT')
depends=('layer-shell-qt' 'libpulse' 'qt6-base' 'qt6-wayland' 'wayland')
makedepends=('cmake' 'ninja' 'pkgconf')

source=("git+https://github.com/tokyo4j/dumbar.git")
sha256sums=('SKIP')

pkgver() {
  cd dumbar
  git describe --long | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cmake -S "$srcdir/dumbar" -B "$srcdir/build" -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build "$srcdir/build"
}

package() {
	DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
